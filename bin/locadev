#!/usr/bin/env bash
# Locadev CLI - portable across Windows (Git Bash), Linux, and macOS.
# Resolve symlinks (~/.local/bin/locadev -> install dir) so LOCADEV_DIR points
# at the real install, not the fallback path below.
SELF="${BASH_SOURCE[0]}"
command -v readlink >/dev/null 2>&1 && SELF="$(readlink -f "$SELF" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
LOCADEV_DIR="$(cd "$(dirname "$SELF")/.." 2>/dev/null && pwd)"
[ -f "$LOCADEV_DIR/Caddyfile" ] || LOCADEV_DIR="D:/Locadev"
command -v cygpath >/dev/null 2>&1 && LOCADEV_DIR=$(cygpath -m "$LOCADEV_DIR")

export PHPRC="$LOCADEV_DIR/bin"
export PATH="$LOCADEV_DIR/bin:$LOCADEV_DIR/bin/mariadb/bin:$PATH"

OS="$(uname -s)"
MARIADB_ADMIN="$LOCADEV_DIR/bin/mariadb/bin/mariadb-admin.exe"
[ -f "$MARIADB_ADMIN" ] || MARIADB_ADMIN="mariadb-admin"
MARIADB_CLI="$LOCADEV_DIR/bin/mariadb/bin/mariadb.exe"
[ -f "$MARIADB_CLI" ] || MARIADB_CLI="$(command -v mariadb || command -v mysql)"
MARIADB_DUMP="$LOCADEV_DIR/bin/mariadb/bin/mariadb-dump.exe"
[ -f "$MARIADB_DUMP" ] || MARIADB_DUMP="$(command -v mariadb-dump || command -v mysqldump)"

# ANSI Colors (only status/action tokens; the rest stays default)
C_RESET=$'\e[0m'
C_GREEN=$'\e[32m'
C_RED=$'\e[31m'
C_YELLOW=$'\e[33m'

port_open() {
    nc -z 127.0.0.1 "$1" 2>/dev/null && return 0
    command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1 && return 0
    ss -tlpn 2>/dev/null | grep -q ":$1 " && return 0
    command -v netstat >/dev/null 2>&1 && netstat -ano 2>/dev/null | grep -q ":$1 .*LISTENING" && return 0
    return 1
}

wait_port() {
    local port="$1" tries=0 max="${2:-30}"
    while ! port_open "$port"; do
        tries=$((tries + 1))
        [ "$tries" -ge "$max" ] && return 1
        sleep 1
    done
}

ensure_mariadb_data() {
    [ -d "$LOCADEV_DIR/data/mariadb/mysql" ] && return 0
    echo "${C_YELLOW}[Locadev] Initializing MariaDB data directory (first run)...${C_RESET}"
    if command -v mariadb-install-db >/dev/null 2>&1; then
        mariadb-install-db --datadir="$LOCADEV_DIR/data/mariadb" \
            --auth-root-authentication-method=normal >/dev/null 2>&1
    elif command -v mysql_install_db >/dev/null 2>&1; then
        mysql_install_db --datadir="$LOCADEV_DIR/data/mariadb" \
            --auth-root-authentication-method=normal >/dev/null 2>&1
    fi
}

db_export() {
    local out="${1:-$LOCADEV_DIR/data/db-sync.sql}"
    if ! port_open 3306; then
        echo "${C_RED}[Locadev] MariaDB is not running. Run 'locadev start' first.${C_RESET}"
        return 1
    fi
    local dbs
    dbs="$($MARIADB_CLI -h 127.0.0.1 -P 3306 -u root -N -B -e 'SHOW DATABASES' 2>/dev/null \
        | grep -Ev '^(mysql|performance_schema|information_schema|sys)$')"
    if [ -z "$dbs" ]; then
        echo "${C_YELLOW}[Locadev] No user databases to export.${C_RESET}"
        return 1
    fi
    mkdir -p "$(dirname "$out")" || return 1
    echo "${C_YELLOW}[Locadev] Exporting databases to $out ...${C_RESET}"
    # word-splitting of $dbs is intentional (space-separated db names)
    if $MARIADB_DUMP -h 127.0.0.1 -P 3306 -u root --add-drop-database --databases $dbs > "$out"; then
        echo "${C_GREEN}[Locadev] Export complete: $out${C_RESET}"
    else
        rm -f "$out"
        echo "${C_RED}[Locadev] Export failed.${C_RESET}"
        return 1
    fi
}

db_import() {
    local in="${1:-$LOCADEV_DIR/data/db-sync.sql}"
    if ! port_open 3306; then
        echo "${C_RED}[Locadev] MariaDB is not running. Run 'locadev start' first.${C_RESET}"
        return 1
    fi
    if [ ! -f "$in" ]; then
        echo "${C_RED}[Locadev] File not found: $in${C_RESET}"
        return 1
    fi
    echo "${C_YELLOW}[Locadev] Importing $in (replaces the databases it contains) ...${C_RESET}"
    if $MARIADB_CLI -h 127.0.0.1 -P 3306 -u root < "$in"; then
        echo "${C_GREEN}[Locadev] Import complete.${C_RESET}"
    else
        echo "${C_RED}[Locadev] Import failed.${C_RESET}"
        return 1
    fi
}

# ===== Action bodies (no banner / no summary) =====
body_start() {
    start_db
    start_web
}

body_stop() {
    echo "${C_YELLOW}[Locadev] Stopping services...${C_RESET}"
    stop_cmds
    echo "${C_GREEN}[Locadev] All services stopped.${C_RESET}"
}

body_restart() {
    echo "${C_YELLOW}[Locadev] Stopping services...${C_RESET}"
    stop_cmds
    sleep 1
    echo "${C_YELLOW}[Locadev] Starting services...${C_RESET}"
    start_db
    start_web
}

body_reload() {
    echo "${C_YELLOW}[Locadev] Reloading Caddyfile...${C_RESET}"
    if [ -f "$LOCADEV_DIR/bin/frankenphp.exe" ]; then
        "$LOCADEV_DIR/bin/frankenphp.exe" reload --config "$LOCADEV_DIR/Caddyfile"
    else
        "$LOCADEV_DIR/bin/frankenphp" reload --config "$LOCADEV_DIR/Caddyfile"
    fi
    if [ $? -eq 0 ]; then
        echo "${C_GREEN}[Locadev] Configuration reloaded.${C_RESET}"
    else
        echo "${C_RED}[Locadev] Reload failed. Is FrankenPHP running?${C_RESET}"
    fi
}

open_dash() {
    case "$OS" in
        Darwin) open https://localhost ;;
        MINGW*|MSYS*|CYGWIN*) start https://localhost ;;
        *) xdg-open https://localhost 2>/dev/null || echo "Open in browser: https://localhost" ;;
    esac
}

# ===== Shared helpers (single visual source) =====
banner() {
    echo "==================================================="
    echo "  Locadev - Just runs. Natively."
    echo "==================================================="
}

summary() {
    if port_open 8080 || port_open 443; then
        echo "  FrankenPHP : ${C_GREEN}[ONLINE]${C_RESET}   https://localhost"
    else
        echo "  FrankenPHP : ${C_RED}[OFFLINE]${C_RESET}"
    fi
    if port_open 3306; then
        echo "  MariaDB    : ${C_GREEN}[ONLINE]${C_RESET}   127.0.0.1:3306"
    else
        echo "  MariaDB    : ${C_RED}[OFFLINE]${C_RESET}"
    fi
    echo "==================================================="
}

stop_cmds() {
    # cloudflared does NOT die when frankenphp stops, so kill the tunnels first: otherwise
    # their public URLs are left hanging (502) and still look active in the dashboard.
    if [ -f "$LOCADEV_DIR/bin/php.exe" ]; then
        PHPRC="$LOCADEV_DIR/bin" "$LOCADEV_DIR/bin/php.exe" "$LOCADEV_DIR/scripts/stop-tunnels.php" >/dev/null 2>&1
    elif [ -x "$LOCADEV_DIR/bin/frankenphp" ]; then
        "$LOCADEV_DIR/bin/frankenphp" php-cli "$LOCADEV_DIR/scripts/stop-tunnels.php" >/dev/null 2>&1
    fi
    curl -s -X POST http://127.0.0.1:2019/stop >/dev/null 2>&1
    # wait for graceful shutdown (process gone), force-kill is only a fallback
    local t=0
    while tasklist //FI "IMAGENAME eq frankenphp.exe" 2>/dev/null | grep -q frankenphp; do
        t=$((t + 1)); [ "$t" -ge 6 ] && break
        sleep 1
    done
    if [ -f "$LOCADEV_DIR/bin/mariadb/bin/mariadbd.exe" ]; then
        taskkill //F //IM frankenphp.exe >/dev/null 2>&1
    else
        pkill -f frankenphp 2>/dev/null
    fi
    "$MARIADB_ADMIN" -h 127.0.0.1 -P 3306 -u root shutdown >/dev/null 2>&1
    # port 3306 closes before InnoDB finishes flushing - wait for the PROCESS, not the port
    t=0
    while tasklist //FI "IMAGENAME eq mariadbd.exe" 2>/dev/null | grep -q mariadbd; do
        t=$((t + 1)); [ "$t" -ge 11 ] && break
        sleep 1
    done
    if [ -f "$LOCADEV_DIR/bin/mariadb/bin/mariadbd.exe" ]; then
        taskkill //F //IM mariadbd.exe >/dev/null 2>&1
    else
        pkill -f mariadbd 2>/dev/null
        pkill -f mysqld 2>/dev/null
    fi
}

ensure_db_files() {
    # Windows-bundle first run: init datadir (must be EMPTY), then tuned my.ini
    if [ ! -d "$LOCADEV_DIR/data/mariadb" ]; then mkdir -p "$LOCADEV_DIR/data/mariadb"; fi
    local fresh=0
    if [ ! -d "$LOCADEV_DIR/data/mariadb/mysql" ] && [ -f "$LOCADEV_DIR/bin/mariadb/bin/mariadb-install-db.exe" ]; then
        rm -f "$LOCADEV_DIR/data/mariadb/my.ini"
        echo "${C_YELLOW}[Locadev] Initializing MariaDB data directory - first run...${C_RESET}"
        "$LOCADEV_DIR/bin/mariadb/bin/mariadb-install-db.exe" \
            --datadir="$LOCADEV_DIR/data/mariadb" >/dev/null 2>&1
        fresh=1
    fi
    [ -f "$LOCADEV_DIR/data/mariadb/my.ini" ] || fresh=1
    if [ "$fresh" = 1 ]; then
        echo "${C_YELLOW}[Locadev] Writing MariaDB config - first run...${C_RESET}"
        cat > "$LOCADEV_DIR/data/mariadb/my.ini" <<INI
[mysqld]
datadir=$LOCADEV_DIR/data/mariadb
port=3306
bind-address=127.0.0.1
innodb_use_native_aio=0
lower_case_table_names=1
max_allowed_packet=64M
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
performance_schema=OFF
max_connections=20
key_buffer_size=8M
aria_pagecache_buffer_size=8M
tmp_table_size=16M
max_heap_table_size=16M
innodb_flush_log_at_trx_commit=2
innodb_flush_neighbors=0
skip_name_resolve=1
innodb_log_file_size=32M
innodb_buffer_pool_size=64M
[client]
port=3306
default-character-set=utf8mb4
INI
    fi
}

ensure_php_ini() {
    # The bundled php.ini points extension_dir at another install (the shipped path, or a
    # Windows path on a shared dual-boot drive). Repoint it only when that path is gone,
    # so a working custom ini is never clobbered - and only when we have an ext/ to use.
    local ini="$LOCADEV_DIR/bin/php.ini" ext="$LOCADEV_DIR/bin/ext" cur want
    [ -f "$ini" ] && [ -d "$ext" ] || return 0
    cur=$(sed -n 's/^extension_dir[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "$ini" | head -n1)
    [ -n "$cur" ] && [ -d "$cur" ] && return 0
    want="extension_dir = \"$ext\""
    grep -qxF "$want" "$ini" && return 0
    echo "${C_YELLOW}[Locadev] Pointing php.ini extension_dir at this install...${C_RESET}"
    sed -i.bak "s|^extension_dir = .*|$want|" "$ini" && rm -f "$ini.bak"
}

start_db() {
    port_open 3306 && return 0
    [ -f "$LOCADEV_DIR/bin/mariadb/bin/mariadbd.exe" ] && ensure_db_files
    echo "${C_YELLOW}[Locadev] Starting MariaDB...${C_RESET}"
    if [ -f "$LOCADEV_DIR/bin/mariadb/bin/mariadbd.exe" ]; then
        powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '$LOCADEV_DIR\\bin\\mariadb\\bin\\mariadbd.exe' -ArgumentList '--defaults-file=\"\"$LOCADEV_DIR\\data\\mariadb\\my.ini\"\"' -WindowStyle Hidden" 2>/dev/null
    elif command -v mariadbd >/dev/null 2>&1 || command -v mysqld >/dev/null 2>&1; then
        DB_BIN="$(command -v mariadbd 2>/dev/null || command -v mysqld)"
        ensure_mariadb_data
        # ponytail: socket in /tmp - NTFS/FAT mounts (dual-boot drives) can't host unix sockets
        "$DB_BIN" --defaults-file="$LOCADEV_DIR/config/my.cnf" \
            --datadir="$LOCADEV_DIR/data/mariadb" \
            --socket="${XDG_RUNTIME_DIR:-/tmp}/locadev-mariadb.sock" \
            >/dev/null 2>&1 &
    else
        echo "${C_RED}[Locadev] MariaDB not found.${C_RESET}"
        echo "Install it, then run 'locadev start' again:"
        case "$(command -v pacman apt-get dnf zypper brew 2>/dev/null | head -n1)" in
            *pacman)  echo "  sudo pacman -S --needed mariadb" ;;
            *apt-get) echo "  sudo apt install mariadb-server" ;;
            *dnf)     echo "  sudo dnf install mariadb-server" ;;
            *zypper)  echo "  sudo zypper install mariadb-server" ;;
            *brew)    echo "  brew install mariadb" ;;
            *)        echo "  Install MariaDB (mariadb-server) with your package manager." ;;
        esac
        return 1
    fi
    if wait_port 3306 30; then
        return 0
    else
        echo "${C_RED}[Locadev] ERROR: MariaDB did not start within 30s. Check data/mariadb/*.err${C_RESET}"
        return 1
    fi
}

start_web() {
    { port_open 8080 || port_open 443; } && return 0
    ensure_php_ini
    echo "${C_YELLOW}[Locadev] Starting FrankenPHP...${C_RESET}"
    if [ -f "$LOCADEV_DIR/bin/frankenphp.exe" ]; then
        powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "\$env:PHPRC='$LOCADEV_DIR\\bin'; Start-Process -FilePath '$LOCADEV_DIR\\bin\\frankenphp.exe' -ArgumentList 'run --config Caddyfile' -WorkingDirectory '$LOCADEV_DIR' -WindowStyle Hidden" 2>/dev/null
    elif [ -x "$LOCADEV_DIR/bin/frankenphp" ]; then
        (cd "$LOCADEV_DIR" && ./bin/frankenphp run --config Caddyfile > /dev/null 2>&1 &)
    else
        echo "${C_RED}[Locadev] FrankenPHP binary not found.${C_RESET}"
        return 1
    fi
    if wait_port 8080 30; then
        return 0
    else
        echo "${C_RED}[Locadev] ERROR: FrankenPHP did not start within 30s. Check the Caddyfile.${C_RESET}"
        return 1
    fi
}

ACTION="${1:-start}"

case "$ACTION" in
    start)
        banner
        body_start
        echo
        summary
        ;;
    stop)
        banner
        body_stop
        summary
        ;;
    restart)
        banner
        body_restart
        echo
        summary
        ;;
    reload)
        banner
        body_reload
        summary
        ;;
    status)
        banner
        summary
        ;;
    open)
        open_dash
        ;;
    db-export)
        banner
        db_export "$2"
        ;;
    db-import)
        banner
        db_import "$2"
        ;;
    menu)
        while true; do
            banner
            summary
            echo "==================================================="
            echo "   1) Start      2) Stop       3) Restart"
            echo "   4) Reload     5) Status     6) Open"
            echo "   0) Exit"
            echo "==================================================="
            if ! read -r -p "   Choose a number and press Enter: " choice; then
                break
            fi
            case "$choice" in
                0) break ;;
                1) body_start ;;
                2) body_stop ;;
                3) body_restart ;;
                4) body_reload ;;
                6) open_dash ;;
                *) ;;
            esac
            echo
        done
        ;;
    help|--help|-h)
        banner
        echo "Usage: locadev [command]"
        echo ""
        echo "Commands:"
        echo "  start       Start FrankenPHP and MariaDB in background (default)"
        echo "  stop        Stop all Locadev services"
        echo "  restart     Restart all Locadev services"
        echo "  reload      Hot reload Caddyfile without downtime"
        echo "  status      Show running status of services"
        echo "  db-export   Dump all user databases to a .sql file (default data/db-sync.sql)"
        echo "  db-import   Import a .sql dump, replacing the databases it contains"
        echo "  menu        Interactive control menu"
        echo "  open        Open dashboard in default web browser"
        ;;
    *)
        echo "${C_RED}[Locadev] Unknown command: $ACTION${C_RESET}"
        echo "Usage: locadev [start|stop|restart|reload|status|open|db-export|db-import|menu]"
        ;;
esac
